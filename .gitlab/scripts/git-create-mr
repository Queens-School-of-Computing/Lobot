#!/usr/bin/env sh

set -xe

# FIXME Better way to remove or omit last newline
# (newlines not allowed as push options)
MR_DESCRIPTION=$(echo $MR_DESCRIPTION|tr -d '\n')

# Create or use existing
git switch --create $_CREATE_BRANCH_NAME || git switch $_CREATE_BRANCH_NAME

git add "$_CREATE_ADD_PATH"

git status -bs

# TODO Wrap this into a reusable script

# TODO Replace with special bot user
git config --global user.email "hello@jmjanzen.com"
git config --global user.name "JM"
git commit -m "$_CREATE_COMMIT_TITLE"
git push -u origin $_CREATE_BRANCH_NAME \
  -o merge_request.create \
  -o merge_request.label=bot \
  -o merge_request.label=infra \
  -o merge_request.target=main \
  -o merge_request.title="$_CREATE_MR_TITLE" \
  -o merge_request.description="$_CREATE_MR_DESCRIPTION" \
  -o merge_request.assign="$_CREATE_MR_ASSIGNED"

  # TODO Put both these fellas in a group, then assign to *it*
  #-o merge_request.assign="av10"
